    "setup:deps": "node native/setup-deps.mjs",
    "validate:quests": "node scripts/validate-quest-browser.mjs",
    "build:native": "node native/build.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@osfui/cli": "0.1.0",
    "rolldown": "1.1.5",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "dependencies": {
    "buffer": "6.0.3",
    "ww2ogg-ts": "0.2.0"
  }
