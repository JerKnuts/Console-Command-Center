{
  "name": "console-command-center",
  "version": "1.4.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --root src/views/console.command-center/main",
    "dev:game": "node scripts/dev-game.mjs",
    "check": "node scripts/check-ui.mjs",
    "build": "node native/build.mjs && node scripts/build-ui.mjs",
